{
  "name": "eslint-config-etherpad",
  "version": "5.0.2",
  "description": "ESLint shareable config used for Etherpad and its plugins",
  "main": "index.js",
  "files": [
    "index.js",
    "node.js",
    "browser.js",
    "plugin.js",
    "tests.js",
    "tests/",
    "flat/",
    "patch/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ether/eslint-config-etherpad.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "etherpad"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ether/eslint-config-etherpad/issues"
  },
  "homepage": "https://github.com/ether/eslint-config-etherpad#readme",
  "scripts": {
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node node_modules/eslint/bin/eslint.js --fix .",
    "lint:flat": "node node_modules/eslint10/bin/eslint.js .",
    "test": "npm run lint && npm run lint:flat"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.1",
    "@rushstack/eslint-patch": "^1.10.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint-import-resolver-typescript": "^3.6.1 <3.10.0",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-eslint-comments": "npm:@eslint-community/eslint-plugin-eslint-comments@^4.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-mocha-flat": "npm:eslint-plugin-mocha@^11.3.0",
    "eslint-plugin-n": "^17.2.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-you-dont-need-lodash-underscore": "^6.14.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint10": "npm:eslint@^10.11.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  }
}
